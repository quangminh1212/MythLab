# Copy to .env (never commit .env). Generate a key: openssl rand -base64 18 | tr '+/' '-_' | tr -d '='
MYTHLAB_ACCESS_KEY=

# Optional
# MYTHLAB_BIND=127.0.0.1     # 0.0.0.0 exposes the server to the LAN
# MYTHLAB_PORT=8765
# GITHUB_TOKEN=              # read-only token for private Done_* repos

# Sign in with Google (sync reading history, follows, bookmarks per account). See reader/README.md.
# MYTHLAB_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com   # OAuth client ID of type "Web application" (comma-separated for several)
# MYTHLAB_ALLOWED_EMAILS=                                        # comma-separated; empty = any verified Google account
