---
// The single brand lock-up: the XLab mark only. The mark has a light and a dark rendition; CSS shows the one that
// fits the resolved scheme (data-mode). The link keeps its accessible name.
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<a id={id} class="brand" href="#/" aria-label="MythLab, về trang chủ" title="MythLab">
  <img class="brand-logo brand-logo-light" src="./icons/xlab-logo.png" width="44" height="28" alt="" decoding="async" />
  <img class="brand-logo brand-logo-dark" src="./icons/xlab-logo-dark.png" width="44" height="28" alt="" decoding="async" />
</a>
