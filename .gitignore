# Web UI (Astro)
web/node_modules/
web/dist/
web/.astro/
web/e2e/out/

# Go server: the embedded web UI is a build product (web/dist copied in); only the placeholder is tracked
server/internal/webui/dist/*
!server/internal/webui/dist/index.html

# Desktop exe resources (icon/manifest) generated by apps/desktop/build.ps1
server/cmd/mythlab/*.syso

# Agent working notes (scratch, not part of the product)
.agents/

# Reading progress synced by the server (next to config.json)
progress.json

# Docker compose secrets
.env

# Piper runtime copied from node_modules by scripts/copy-tts.mjs
web/public/tts/ort/
web/public/tts/ort130/
web/public/tts/piper/
web/public/tts/kokoro/
# Piper voice models downloaded by scripts/fetch-models.mjs (for the GitHub release upload), never committed
web/public/tts/models/
