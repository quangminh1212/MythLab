.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Reader
reader/.cache/
reader/library/

# APK build (giữ local, không đưa lên repo public)
apk/

# Apps (build output, dependencies, signing keys)
apps/android/node_modules/
apps/android/www/
apps/android/dist/
apps/android/android/app/build/
apps/android/android/.gradle/
