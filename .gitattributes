# Normalise text files; keep line endings stable across Windows and Linux checkouts.
* text=auto

*.sh      text eol=lf
gradlew   text eol=lf
*.go      text eol=lf
*.ts      text eol=lf
*.astro   text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.jar     binary
*.zip     binary
*.syso    binary
*.exe     binary
*.apk     binary
